{
  "name": "skein-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "skein-ready": "scripts/skein-ready.mjs"
  },
  "scripts": {
    "ready": "node scripts/skein-ready.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:smoke": "playwright test",
    "e2e:auth": "node scripts/e2e-auth.mjs",
    "mock": "python -m uvicorn mock.main:app --port 4010",
    "simulate": "python -m mock.generator simulate",
    "test:mock": "python -m pytest mock/tests -q"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  }
}
