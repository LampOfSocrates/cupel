# Build context = package manifests, src/, index.html, vite/ts config,
# agentic.config.ts (src imports it), mock/.
node_modules/
.git/
dist/
coverage/
.pytest_cache/
**/__pycache__/
# `*.sqlite` alone matches root level ONLY, so mock/cupel-mock.sqlite was
# being baked into the image — harmless while the disk was ephemeral, fatal
# for CUPEL_STORAGE=s3 (a database that already exists makes `litestream
# restore -if-db-not-exists` skip the restore, so the demo would silently boot
# on a developer's stale data instead of the replica). P2-PERSIST.
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm
mock/tests/
tests/
sketches/
# NOT docs/ — the runtime stage COPYs docs/index.html and docs/assets
# (mock/root.py serves them); .dockerignore only controls the build
# CONTEXT, not the final image, so leaving the rest of docs/ (internal
# planning notes) available here costs nothing — those paths are simply
# never named in a Dockerfile COPY.
autorun/
.claude/
cupel-starter.zip
*.md
openapi.yaml
vitest.config.ts
