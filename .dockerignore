# Build context = package manifests, src/, index.html, vite/ts config,
# agentic.config.ts (src imports it), mock/.
node_modules/
.git/
dist/
coverage/
.pytest_cache/
**/__pycache__/
# `*.sqlite` alone matches root level ONLY, so mock/cupel-mock.sqlite was
# being baked into the image — harmless while the disk was ephemeral, fatal
# for CUPEL_STORAGE=s3 (a database that already exists makes `litestream
# restore -if-db-not-exists` skip the restore, so the demo would silently boot
# on a developer's stale data instead of the replica). P2-PERSIST.
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm
mock/tests/
tests/
sketches/
docs/
autorun/
.claude/
cupel-starter.zip
cupel-run.sh
*.md
openapi.yaml
vitest.config.ts
